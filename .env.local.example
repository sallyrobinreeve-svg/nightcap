NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public site URL (used for post-auth redirects). Set in Vercel for production.
NEXT_PUBLIC_SITE_URL=https://mynightcap.vercel.app

# Required for delete account feature (get from Supabase Dashboard > Settings > API > service_role)
# Do not expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# UGC safeguards (App Store Guideline 1.2) - email alerts for reports/blocks
# Get API key from resend.com; verify a domain for production sending
RESEND_API_KEY=re_xxxxxxxxxxxx
UGC_ALERT_EMAIL=nightcapt1@outlook.com
# Optional: custom sender (must be verified in Resend)
# EMAIL_FROM=NightCapt Alerts <alerts@yourdomain.com>

# Health check (for you / uptime monitors): GET /api/health — returns 503 if public Supabase env is missing
